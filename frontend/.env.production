# 打包构建（vite build / pnpm tauri build）时生效的端点配置。
#
# 打包后前端由 Tauri 自定义协议托管，没有 Vite dev proxy，必须显式直连本机
# sidecar 后端。端口与 config/runtime.exs 默认 PHOENIX_PORT 及 tauri.conf.json
# 的 CSP connect-src 保持一致（4658）。dev 态走 frontend/.env（before-tauri-dev.sh），
# 不受本文件影响。
VITE_API_ENDPOINT=http://127.0.0.1:4658
VITE_WS_ENDPOINT=ws://127.0.0.1:4658/socket
