              "minimum": 0
            },
            "http_2xx": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "ax": {
          "type": "object",
          "required": [
            "ax_dumps",
            "text_dumps",
            "screenshots"
          ],
          "additionalProperties": true,
          "properties": {
