            "text_dumps": {
              "type": "integer",
              "minimum": 0
            },
            "screenshots": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "db_snapshot": {
          "type": "object",
          "required": [
            "found",
            "count"
          ],
          "additionalProperties": true,
          "properties": {
            "found": {
              "type": "boolean"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "production_fingerprint": {
          "type": "object",
          "required": [
            "head",
            "production_sources_snapshot",
            "model_lifecycle"
          ],
          "additionalProperties": true,
          "properties": {
            "head": {
              "type": [
                "string",
                "null"
              ]
            },
            "production_sources_snapshot": {
              "type": [
                "object",
                "null"
              ]
            },
            "model_lifecycle": {
              "type": "object"
            }
          }
        }
      }
    },
    "release_layer_summary": {
      "title": "quality-release-layer/v1",
      "description": "B42 CP1：release（确定性 provider）/ release-real-llm（真实模型 provider）分层结果。两类结果不得合并成单一 PASS；空 tier = not_run + empty_tier（exit 65），不得当 PASS 或全部通过；真实模型 PASS 需要重复/保留措辞/身份/证据链/原生 run 判据全部满足。",
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "tier",
        "tier_class",
        "surface",
        "provider",
        "batch_id",
        "git_head",
        "status",
        "exit_code",
        "reason",
        "reason_codes",
        "known_fact",
        "registered_scenarios",
        "counts",
        "layers",
        "separation",
        "replay",
        "retention",
        "failure_denominator",
        "blocked_scenarios",
        "not_run_scenarios",
        "evidence_missing_scenarios",
        "failure_refs",
        "scenarios",
        "open_gaps"
      ],
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "const": "quality-release-layer/v1"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "tier": {
          "enum": [
            "release",
            "release-real-llm"
          ]
