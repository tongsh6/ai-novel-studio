{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality/acceptance/evidence-schema.json",
  "title": "AI Novel Studio Scenario Acceptance Evidence",
  "description": "场景证据的描述性 schema。B41 起真正的执行结果契约是 verdict-schema.json（quality-verdict/v2）；本文件顶层的旧字段仅为历史兼容。B42 CP0 §6.4 冻结的 additive 扩展放在 $defs：quality-evidence-chain/v1（CP2 求证证据链，sidecar evidence-chain.json）、quality-native-run/v1（CP3 原生 run manifest，sidecar native-run-manifest.json）、quality-release-layer/v1（CP1 release/release-real-llm 分层结果，sidecar release-layer.json）。这些 sidecar 不改变 quality-verdict/v2 的读取语义：缺 sidecar 或字段缺失一律 unknown/evidence_missing，不得默认 PASS；未知可选字段不得让旧证据读取失败。",
  "type": "object",
  "required": [
    "scenario_id",
    "surface",
    "tier",
    "artifact_dir",
    "required"
  ],
  "properties": {
    "scenario_id": {
      "type": "string"
    },
    "surface": {
      "enum": [
        "browser",
        "tauri"
      ]
    },
    "tier": {
      "type": "string"
    },
    "artifact_dir": {
      "type": "string"
    },
    "required": {
      "type": "array",
      "items": {
        "enum": [
          "screenshot",
          "websocket_frames",
          "app_jsonl",
          "turn_result",
          "action_result",
          "ui_state",
          "backend_log",
          "llm_http_log",
          "provider_secrets_metadata",
          "persistence_snapshot",
          "summary_json",
          "replay_api_response",
          "seed_log",
          "export_artifact",
          "progress_jsonl",
          "word_count_json",
          "native_screenshots",
          "native_transport_jsonl",
          "persisted_session",
          "memory_facts",
          "audit_report"
        ]
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "layers": {
      "title": "机制证据 / 模型行为证据分层（B42 CP0）",
      "description": "两类结果不得互相代签。确定性 provider 批次只能 mechanism=pass + model_behavior=not_applicable；真实模型 PASS 必须有独立 model_behavior 证据。",
      "type": "object",
      "required": [
        "mechanism",
        "model_behavior"
      ],
      "additionalProperties": false,
      "properties": {
        "mechanism": {
          "type": "object",
          "required": [
            "status",
            "evidence_refs"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "unknown",
                "not_applicable"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "model_behavior": {
          "type": "object",
          "required": [
            "status",
            "evidence_refs"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "unknown",
                "not_applicable"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "evidence_chain": {
      "title": "quality-evidence-chain/v1",
      "description": "B42 CP2：Base → Observation → 后续真实 provider 请求 → self_report used refs 的证据链。集合关系由 scripts/lib/quality/evidence_chain.mjs 强制：used_context_refs ⊆ Base refs ∪ 实际观察 refs；未读取/stale ref 不得获得证据信用；supplied≠used；未返回自报告=unknown；观察必须先于后续 provider 请求。缺 base_refs/used_context_refs 只记 unknown，不得反推。 B42 §12.2（2026-10-28 additive）：binding=verified 必须无任何 blocker；必需证据完整性由场景声明（$defs.evidence_requirements）逐维度判定，缺必需字段/未执行/未知→evidence_missing，硬违规→violated。 B42 §13（2026-10-30 additive）：inclusion 只由请求侧同源记录（request_observation_refs）授予，time_order 只证明顺序；缺失与显式空数组分开；used refs 只从产生自报告的调用授信；判定从原始字段重算，不信任序列化派生缓存。",
      "type": "object",
      "required": [
        "schema_version",
        "run_ref",
        "scenario_id",
        "base_refs",
        "base_refs_status",
        "observations",
        "provider_calls",
        "observation_to_provider_call",
        "used_context_refs",
        "used_context_refs_status",
        "used_context_refs_source",
        "unbound_refs",
        "unresolved_refs",
        "preparation_outcome",
        "stale_on_restore",
        "replay_provider_called",
        "blockers",
        "violations",
        "binding",
        "generated_at"
      ],
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "const": "quality-evidence-chain/v1"
        },
        "run_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "scenario_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "base_refs_status": {
          "enum": [
            "recorded",
            "unknown"
          ]
        },
        "base_ref_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "source",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "observation_ref",
              "query",
              "tool",
              "outcome",
              "source_refs",
              "source_revision",
              "coverage",
              "observed_at",
              "run_ref",
              "turn_ref",
              "observed_in_calls",
              "stale",
              "metadata_missing"
            ],
            "additionalProperties": false,
            "properties": {
              "observation_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "query": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "outcome": {
                "enum": [
                  "observed",
                  "empty",
                  "ambiguous",
                  "conflict",
                  "stale",
                  "error",
                  "unknown"
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "source_revision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "coverage": {
                "type": "object",
                "required": [
                  "kind",
                  "detail"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detail": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "run_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "turn_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observed_in_calls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "stale": {
                "type": "boolean"
              },
              "metadata_missing": {
                "type": "boolean"
              },
              "observed_in_calls_status": {
                "enum": [
                  "recorded",
                  "unknown"
                ],
                "description": "B42 §13（additive 可选）：观察侧是否记录了 observed_in_calls。recorded=数组记录（含显式空数组）；unknown=历史 artifact/生产尚未记录。缺失不能反推“明确未被任何调用看到”。"
              }
            }
          }
        },
        "observation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "provider_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider_call_ref",
              "at",
              "turn_ref",
              "run_ref",
              "step",
              "provider",
              "provider_class",
              "model",
              "actual_model",
              "real",
              "request_observation_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "provider_call_ref": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "turn_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "run_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "step": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "provider_class": {
                "enum": [
                  "real_model",
                  "deterministic",
                  "unknown"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "actual_model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "real": {
                "type": "boolean",
                "description": "B42 §13：只由 provider 分类决定；手填 real=true 不能把确定性 provider 变成真实模型证据。"
              },
              "request_observation_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "real_claimed": {
                "type": "boolean",
                "description": "B42 §13（additive 可选）：输入是否手填 real=true。真实模型身份只由 provider 分类决定；确定性 provider 手填 real=true 记 deterministic_provider_claims_real 违规。"
              },
              "request_observation_refs_status": {
                "enum": [
                  "recorded",
                  "unknown"
                ],
                "description": "B42 §13（additive 可选）：请求侧是否记录观察包含。recorded=数组记录（含显式空数组=请求明确不含观察）；unknown=缺失。只有 recorded 且包含该 observation_ref 才能授 inclusion 信用。"
              }
            }
          }
        },
        "observation_to_provider_call": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "observation_ref",
              "provider_call_ref",
              "ordered",
              "linked_by",
              "provider_real"
            ],
            "additionalProperties": false,
            "properties": {
              "observation_ref": {
                "type": "string",
                "minLength": 1
              },
              "provider_call_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ordered": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "B42 §13：只表达时间先后；true/false/null(时间缺失)。顺序≠请求实际包含。"
              },
              "linked_by": {
                "enum": [
                  "request_observation_ref",
                  "explicit",
                  "time_order",
                  "none"
                ],
                "description": "request_observation_ref=请求侧同源记录包含；explicit=observation.observed_in_calls 反向声称（只作交叉核对）；time_order=仅时间顺序（不授包含信用）；none=无后续真实调用。"
              },
              "provider_real": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "includes_observation": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "B42 §13（additive 可选）：该链接是否证明观察实际进入该请求。true=请求侧记录包含；false=请求侧记录明确未包含；null=任一侧未记录（顺序链接不证明包含）。"
              }
            }
          }
        },
        "used_context_refs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "used_context_refs_status": {
          "enum": [
            "reported",
            "unknown"
          ]
        },
        "used_context_refs_source": {
          "enum": [
            "self_report",
            "inferred_supplied",
            "missing"
          ]
        },
        "supplied_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unbound_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unresolved_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preparation_outcome": {
          "enum": [
            "ready",
            "continue_seeking",
            "degraded",
            "awaiting_author",
            "blocked",
            "unknown"
          ]
        },
        "stale_on_restore": {
          "enum": [
            "none",
            "stale_detected",
            "unknown"
          ]
        },
        "replay_provider_called": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": true,
            "properties": {
              "code": {
                "enum": [
                  "unbound_ref",
                  "unread_ref_credited",
                  "stale_observation_credited",
                  "observation_after_provider_call",
                  "used_refs_inferred_from_supplied",
                  "replay_provider_called",
                  "observation_source_missing",
                  "observation_link_conflict",
                  "deterministic_provider_claims_real"
                ]
              }
            }
          }
        },
        "binding": {
          "type": "object",
          "required": [
            "binding_status",
            "reason_codes",
            "observation_link_count",
            "real_observation_link_count",
            "used_bound_count",
            "used_unbound_count"
          ],
          "additionalProperties": true,
          "properties": {
            "binding_status": {
              "enum": [
                "verified",
                "partial",
                "unknown",
                "violated"
              ]
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "observations_link_count": {
              "type": "integer",
              "minimum": 0
            },
            "real_observation_link_count": {
              "type": "integer",
              "minimum": 0,
              "description": "B42 §13：= 请求侧同源包含且真实 provider 调用的观察数；仅时间顺序的链接不计入。"
            },
            "used_bound_count": {
              "type": "integer",
              "minimum": 0
            },
            "used_unbound_count": {
              "type": "integer",
              "minimum": 0
            },
            "request_inclusion_link_count": {
              "type": "integer",
              "minimum": 0,
              "description": "B42 §13：请求侧同源记录证明“观察实际进入真实请求”的观察数（不含仅时间顺序）。"
            },
            "derived_mismatch": {
              "type": "boolean",
              "description": "B42 §13：序列化派生缓存（links/blockers/violations/unbound_refs）与原始字段重算不一致。true 时不得 verified，release 层按 evidence_missing 处理。"
            }
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "replay_status": {
          "enum": [
            "not_executed",
            "no_provider_call",
            "provider_called",
            "unknown"
          ],
          "description": "B42 §12.1（2026-10-28 additive，可选）：replay 证据三态。not_executed=明确未运行 replay，不能当作已验证不调 provider；no_provider_call=replay 已执行且证明未重调 provider，可作 replay 证据；provider_called=replay 重调 provider，不得作为证据信用；unknown=历史 artifact 未表达（旧布尔 replay_provider_called=false 不得反推“已验证未调用”）。"
        },
        "used_context_refs_provider_call_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "B42 §13（additive 可选）：产生 used_context_refs 自报告的实际 provider call（provider_call_ref）。缺失/null=无法定位报告调用；used 非空时不得授信，记 used_context_refs_call_unknown（evidence_missing）。",
          "minLength": 1
        }
      }
    },
    "native_run_manifest": {
      "title": "quality-native-run/v1",
      "description": "B42 CP3：原生 artifact 目录的统一 run manifest。failure 存在即 fail；termination 非 0/非 EXIT 即 fail；final 与 failure 并存只看 final 判 PASS 被禁止；scoped 结果 full_matrix_established=false，不得外推全矩阵。",
      "type": "object",
      "required": [
        "schema_version",
        "artifact_dir",
        "layout",
        "scanned_at",
        "run",
        "final",
        "failure",
        "scoped",
        "checks",
        "termination",
        "native_transport",
        "ax",
        "db_snapshot",
        "production_fingerprint",
        "run_evidence",
        "status",
        "reason_codes",
        "pass_scope",
        "full_matrix_established"
      ],
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "const": "quality-native-run/v1"
        },
        "artifact_dir": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "enum": [
            "nested-run",
            "flat"
          ]
        },
        "scanned_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "evidence_missing"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "pass_scope": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "full_scope",
            "scoped_scope_only",
            "unknown_scope",
            null
          ]
        },
        "full_matrix_established": {
          "type": "boolean"
        },
        "run": {
          "type": "object",
          "required": [
            "found",
            "summary_path",
            "slice_id",
            "surface",
            "driver",
            "driver_is_native",
            "provider",
            "provider_class",
            "model",
            "scope",
            "identity_conflicts"
          ],
          "additionalProperties": true,
          "properties": {
            "found": {
              "type": "boolean"
            },
            "summary_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "slice_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "surface": {
              "type": [
                "string",
                "null"
              ]
            },
            "driver": {
              "type": [
                "string",
                "null"
              ]
            },
            "driver_is_native": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider_class": {
              "enum": [
                "real_model",
                "deterministic",
                "unknown"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "scope": {
              "type": [
                "string",
                "null"
              ]
            },
            "identity_conflicts": {
              "type": "array"
            }
          }
        },
        "final": {
          "type": "object",
          "required": [
            "found",
            "path",
            "at"
          ],
          "additionalProperties": true,
          "properties": {
            "found": {
              "type": "boolean"
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "failure": {
          "type": "object",
          "required": [
            "found",
            "path",
            "at",
            "reason"
          ],
          "additionalProperties": true,
          "properties": {
            "found": {
              "type": "boolean"
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "at": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "scoped": {
          "type": "object",
          "required": [
            "scope_class",
            "scope_text",
            "limitations",
            "full_matrix_established"
          ],
          "additionalProperties": true,
          "properties": {
            "scope_class": {
              "enum": [
                "full",
                "scoped",
                "unknown"
              ]
            },
            "scope_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "limitations": {
              "type": "array",
