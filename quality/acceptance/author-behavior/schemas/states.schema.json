{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author-behavior-states/v1",
  "title": "B70 author behavior state fixtures",
  "type": "object",
  "required": ["schema", "frozen_at", "frozen_by", "global_invariants", "states"],
  "properties": {
    "schema": {"const": "author-behavior-states/v1"},
    "frozen_at": {"type": "string"},
    "frozen_by": {"type": "string"},
    "global_invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {"id": {"type": "string", "pattern": "^G[0-9]+-[a-z0-9-]+$"}, "description": {"type": "string", "minLength": 8}}
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "summary", "seed", "dimensions"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]+-[a-z0-9-]+$"},
          "summary": {"type": "string", "minLength": 8},
          "seed": {"type": "object", "required": ["kind"]},
          "dimensions": {"type": "object", "additionalProperties": {"type": "boolean"}}
        }
      }
    }
  }
}
