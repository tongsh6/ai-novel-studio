{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author-behavior-fixtures/v1",
  "title": "B70 deterministic page-runner fixtures (stimulus only, independent from oracles)",
  "type": "object",
  "required": ["schema", "frozen_at", "frozen_by", "fixtures"],
  "properties": {
    "schema": {"const": "author-behavior-fixtures/v1"},
    "frozen_at": {"type": "string"},
    "frozen_by": {"type": "string"},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "expression", "action", "note"],
        "properties": {
          "case_id": {"type": "string"},
          "expression": {"type": "string", "minLength": 2},
          "action": {"enum": ["reply", "ask_author"]},
          "note": {"type": "string", "minLength": 8}
        }
      }
    }
  }
}
