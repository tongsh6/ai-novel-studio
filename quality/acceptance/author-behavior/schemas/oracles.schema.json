{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author-behavior-oracles/v1",
  "title": "B70 author behavior oracles",
  "type": "object",
  "required": ["schema", "frozen_at", "frozen_by", "behavior_vocabulary", "hard_oracles", "target_oracles", "semantic_unknown_policy", "excluded"],
  "properties": {
    "schema": {"const": "author-behavior-oracles/v1"},
    "frozen_at": {"type": "string"},
    "frozen_by": {"type": "string"},
    "behavior_vocabulary": {"type": "object", "additionalProperties": {"type": "string"}},
    "hard_oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "invariant", "kind", "description", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^HO[0-9]+-[a-z0-9-]+$"},
          "invariant": {"type": "string"},
          "kind": {"type": "string"},
          "description": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "target_oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target_id", "allowed_result_sets", "negative_traps", "semantic_policy"],
        "properties": {
          "target_id": {"type": "string"},
          "allowed_result_sets": {"type": "array", "minItems": 1},
          "negative_traps": {"type": "array", "items": {"type": "object", "required": ["id", "expect"]}},
          "semantic_policy": {"type": "string"}
        }
      }
    },
    "semantic_unknown_policy": {"type": "string"},
    "excluded": {"type": "string"}
  }
}
