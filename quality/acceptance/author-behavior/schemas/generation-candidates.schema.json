{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "author-behavior-generation-candidates/v1",
  "type": "object",
  "required": ["schema", "generation_id", "generated_at", "candidates", "coverage"],
  "properties": {
    "schema": {"const": "author-behavior-generation-candidates/v1"},
    "generation_id": {"type": "string", "pattern": "^ab-[A-Za-z0-9-]+$"},
    "generated_at": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "generation_id", "target_id", "state_id", "persona_id", "asset_layer", "expression", "style", "source_refs", "sequence_kind", "boundary_tags", "semantic_cell_id", "expected", "normalized_expression_sha", "review", "flags", "split_suggestion", "raw_response"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "generation_id": {"type": "string", "pattern": "^ab-[A-Za-z0-9-]+$"},
          "target_id": {"type": "string", "minLength": 1},
          "state_id": {"type": "string", "minLength": 1},
          "persona_id": {"type": "string", "pattern": "^p-[a-z0-9-]+$"},
          "asset_layer": {"enum": ["core", "exploration", "journey"]},
          "expression": {"type": "string", "minLength": 2},
          "style": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "sequence_kind": {"enum": ["single_turn", "multi_turn_candidate"]},
          "boundary_tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "semantic_cell_id": {"type": "string", "minLength": 1},
          "expected": {"type": "object"},
          "normalized_expression_sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "review": {
            "type": "object",
            "required": ["status", "value", "reviewer", "reviewed_at", "notes"],
            "properties": {
              "status": {"enum": ["pending", "shortlisted", "accepted", "rejected", "unknown"]},
              "value": {"enum": ["new_boundary", "new_persona_behavior", "wording_variant", "rejected"]},
              "reviewer": {"type": ["string", "null"]},
              "reviewed_at": {"type": ["string", "null"]},
              "notes": {"type": "string"}
            }
          },
          "flags": {"type": "array", "items": {"type": "string"}},
          "split_suggestion": {"enum": ["dev", "holdout", "explore"]},
          "raw_response": {"type": "string"}
        }
      }
    },
    "coverage": {"type": "object"}
  }
}
