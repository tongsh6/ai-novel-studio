{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author-behavior-cases/v1",
  "title": "B70 frozen author behavior cases",
  "type": "object",
  "required": ["schema", "frozen_at", "frozen_by", "cases"],
  "properties": {
    "schema": {"const": "author-behavior-cases/v1"},
    "frozen_at": {"type": "string"},
    "frozen_by": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "target_id", "state_id", "split", "tier", "provenance", "expression", "expression_frozen", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^C-[A-Z0-9-]+$"},
          "target_id": {"type": "string"},
          "state_id": {"type": "string"},
          "split": {"enum": ["dev", "regression", "holdout", "explore"]},
          "tier": {"enum": ["pr-smoke", "nightly", "explore"]},
          "provenance": {
            "type": "object",
            "required": ["kind", "frozen_at"],
            "properties": {
              "kind": {"enum": ["human_template", "derived_frozen", "generated_frozen"]},
              "source_refs": {"type": "array", "items": {"type": "string"}},
              "generator": {"type": "string"},
              "generated_at": {"type": "string"},
              "frozen_at": {"type": "string"}
            }
          },
          "expression": {"type": "string", "minLength": 2},
          "expression_frozen": {"const": true},
          "expected": {
            "type": "object",
            "required": ["allowed_actions", "allowed_effects", "forbidden_behaviors", "oracle_refs"],
            "properties": {
              "allowed_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "allowed_effects": {"type": "array", "items": {"type": "string"}},
              "forbidden_behaviors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "oracle_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
