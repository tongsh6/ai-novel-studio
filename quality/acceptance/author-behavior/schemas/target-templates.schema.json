{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author-behavior-targets/v1",
  "title": "B70 author behavior target templates",
  "type": "object",
  "required": ["schema", "frozen_at", "frozen_by", "outcome_vocabulary", "targets"],
  "properties": {
    "schema": {"const": "author-behavior-targets/v1"},
    "frozen_at": {"type": "string"},
    "frozen_by": {"type": "string"},
    "outcome_vocabulary": {
      "type": "object",
      "required": ["actions", "adoption_effects"],
      "properties": {
        "actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "adoption_effects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "family", "goal", "allowed_actions", "allowed_effects", "forbidden_behaviors", "state_dimensions", "negative_traps", "expression_guidance"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]+-[a-z0-9-]+$"},
          "family": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "goal": {"type": "string", "minLength": 8},
          "allowed_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "allowed_effects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "forbidden_behaviors": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "state_dimensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "negative_traps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "expression_guidance": {"type": "string", "minLength": 8}
        }
      }
    }
  }
}
