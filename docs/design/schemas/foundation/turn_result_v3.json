{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "foundation/turn_result_v3.json",
  "title": "TurnResultV3",
  "description": "v3 运行时 TurnResult 线格式（draft）。与 turn_result_v2.json 的关系：v2 是 ADR-0015 时代的历史冻结，v3 描述 UA-01 之后的真实主链输出，schema_version 当前为 '3.0-draft'（semver 收敛为 ADR-0024 Deferred 项）。additionalProperties=true：v3 draft 期容忍后端新增字段，漂移检测聚焦决策面字段与 ui_cards（ADR-0024 决策 5）；ui_cards / candidate_directions 的条目收紧由前端 barrel（lib/schemas.ts）用 ui_card.json / candidate_direction.json 生成物组合完成，codegen 不解析跨文件 $ref。",
  "type": "object",
  "required": ["turn_id", "phase", "status", "assistant_message"],
  "additionalProperties": true,
  "definitions": {
    "adoption_entry": {
      "type": "object",
      "required": ["artifact_id", "artifact_type", "adoption_status", "requires_adoption", "payload"],
      "properties": {
        "artifact_id": { "type": "string" },
        "artifact_type": { "type": "string" },
        "adoption_status": { "type": "string" },
        "requires_adoption": { "type": "boolean" },
        "revision_base": { "type": ["string", "null"] },
        "source_turn_ref": { "type": ["string", "null"] },
        "source_tool_result_ref": { "type": ["string", "null"] },
        "payload": { "type": "object" }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "当前为 '3.0-draft'。"
    },
    "turn_id": { "type": "string", "minLength": 1 },
    "parent_turn_id": { "type": ["string", "null"] },
    "frame_ref": { "type": "string" },
    "phase": { "type": "string" },
    "status": { "type": "string" },
    "next_action": { "type": "string" },
    "assistant_message": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" }
      }
    },
    "frame_summary": {
      "type": "object",
      "properties": {
        "frame_type": { "type": "string" },
        "dialogue_goal": { "type": "string" },
        "uncertainty": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ui_cards": {
      "type": "array",
      "description": "信息通告卡片（S2/S3 展示载体 + result_card）。条目形状见 foundation/ui_card.json。",
      "items": { "$ref": "ui_card.json" }
    },
    "available_actions": {
      "type": "array",
      "description": "UI 可提交动作唯一来源（ADR-0007；00c §7 #10）。",
      "items": {
        "type": "object",
        "required": ["action_id", "action_type"],
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "action_type": { "type": "string", "minLength": 1 },
          "label_key": { "type": "string" },
          "source_turn_ref": { "type": "string" },
          "target_ref": { "type": "string" },
          "behavior_ref": { "type": "string" },
          "candidate_set_ref": { "type": "string" },
          "candidate_ref": { "type": "string" },
          "enabled": { "type": "boolean" },
          "idempotency_key": { "type": "string" },
          "trace_ref": { "type": "string" },
          "quality_finding_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "candidate_directions": {
      "type": "array",
      "description": "S1 决策面驱动字段。条目形状见 foundation/candidate_direction.json。",
      "items": { "$ref": "candidate_direction.json" }
    },
    "adoption_state": {
      "type": "object",
      "description": "S2 决策面驱动字段（逐候选独立采纳单元，AU-09）。",
      "required": ["pending", "resolved"],
      "properties": {
        "pending": { "type": "array", "items": { "$ref": "#/definitions/adoption_entry" } },
        "resolved": { "type": "array", "items": { "$ref": "#/definitions/adoption_entry" } }
      }
    },
    "behavior_state": {
      "type": "object",
      "description": "S3/S4 决策面驱动字段（BehaviorState.snapshot/1 形状，ADR-0008）。",
      "properties": {
        "active": { "type": ["object", "null"] },
        "history": { "type": "array", "items": { "type": "object" } }
      }
    },
    "quality_review": {
      "type": "object",
      "description": "S5 决策面驱动字段（ADR-0020）。字段必填集与 QualityReviewCard 消费口径一致，缺失即漂移告警。",
      "required": ["status", "policy_action", "review_status", "findings"],
      "properties": {
        "status": { "type": "string" },
        "policy_action": { "type": "string" },
        "review_status": { "type": "string" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["quality_gate", "validator", "severity", "action", "summary"],
            "properties": {
              "quality_gate": { "type": "string" },
              "validator": { "type": "string" },
              "severity": { "type": "string" },
              "action": { "type": "string" },
              "summary": { "type": "string" },
              "evidence_spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "text": { "type": "string" } }
                }
              },
              "brief_field_refs": { "type": "array", "items": { "type": "string" } },
              "can_override": { "type": "boolean" }
            }
          }
        }
      }
    },
    "agent_run": {
      "type": "object",
      "description": "S6 决策面关联摘要（AgentFinalizer 注入；前端会在运行时补充 events / provider_runs / activity_loaded 客户端字段）。",
      "properties": {
        "run_id": { "type": "string" },
        "run_mode": { "type": "string" },
        "status": { "type": "string" },
        "phase": { "type": "string" },
        "parent_turn_ref": { "type": ["string", "null"] },
        "profile_ref": { "type": "string" },
        "long_run_task_ref": { "type": ["string", "null"] }
      }
    },
    "trace_summary": {
      "type": "object",
      "description": "脱敏 trace 摘要（ADR-0014）。"
    },
    "projection_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["projection_type", "projection_id"],
        "properties": {
          "projection_type": { "type": "string" },
          "projection_id": { "type": "string" },
          "source_revision_refs": { "type": "array", "items": { "type": "string" } },
          "refresh_status": { "type": ["string", "null"] }
        }
      }
    },
    "truthfulness": {
      "type": "object",
      "description": "诚实性事实（工具是否调用、是否写入等）。"
    },
    "produced_at": { "type": "string" }
  }
}
