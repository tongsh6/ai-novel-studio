    "arc": { "type": "array", "items": { "$ref": "ledger_thread_entry.json" } },
    "conflict": { "type": "array", "items": { "$ref": "ledger_thread_entry.json" } },
    "promise": { "type": "array", "items": { "$ref": "ledger_thread_entry.json" } },
    "information": { "type": "array", "items": { "$ref": "ledger_thread_entry.json" } },
    "emotion_curve": { "type": "array", "items": { "$ref": "ledger_thread_entry.json" } }
  },
  "additionalProperties": false
}
