        "properties": {
          "action": {
            "enum": [
              "execute",
              "plan",
              "explore"
            ],
            "type": "string"
          },
          "adopted_content_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "capability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "仅 execute 时提供；plan/explore 时省略或为 null。"
          },
          "character_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "仅 revise_character_profile 时提供：从「角色索引」原样复制 character_ref（身份），不得猜。"
          },
          "dialogue_goal": {
            "minLength": 1,
            "type": "string"
          },
