                  "tool": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "tool",
                  "query"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "pending_artifact_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
